{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "custom/usagetop"
  ],
  "modules-right": [
    "tray",
    "clock"
  ],
  "clock": {
    "format": "{:%H:%M}"
  },
  "tray": {
    "spacing": 8
  },
  "custom/usagetop": {
    "exec": "usagetop status --waybar",
    "return-type": "json",
    "interval": 60,
    "on-click": "usagetop toggle"
  }
}
