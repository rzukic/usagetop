<?xml version="1.0" encoding="utf-8"?>
<!-- Rings you choose, at 2x2. Placed without asking: it starts with the windows
     closest to empty, and its settings (long-press › Settings) change the picks.
     It may grow a little, never across the screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.github.rzukic.usagetop.widget.RingsConfigActivity"
    android:description="@string/rings_widget_description"
    android:initialLayout="@layout/widget_rings"
    android:maxResizeHeight="250dp"
    android:maxResizeWidth="250dp"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview_rings"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
