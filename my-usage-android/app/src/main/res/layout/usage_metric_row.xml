<?xml version="1.0" encoding="utf-8"?>
<!-- One quota window: label, level, figure, reset. Mirrors OpenUsage's DashboardMetricRow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/metric_label"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <io.github.rzukic.usagetop.ui.MeterView
            android:id="@+id/metric_meter"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/metric_value"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/metric_reset"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
