<?xml version="1.0" encoding="utf-8"?>
<!-- One window on the detail screen: its level, when it resets, and the drawdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/window_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/window_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/window_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <!-- How fast it is going and where that ends: the forecast in words. -->
    <TextView
        android:id="@+id/window_burn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:visibility="gone" />

    <io.github.rzukic.usagetop.ui.DrawdownChart
        android:id="@+id/window_chart"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/window_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
