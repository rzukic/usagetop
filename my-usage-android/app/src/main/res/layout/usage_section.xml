<?xml version="1.0" encoding="utf-8"?>
<!-- A provider's name, its plan badge, and the card holding its metric rows.
     The card is the tap target, so the press highlight takes the card's shape
     rather than a rectangle spanning the label too. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/section_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="7dp"
            android:importantForAccessibility="no"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/section_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/section_stale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/section_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/plan_badge"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/section_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_surface"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/card_ripple"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp" />
</LinearLayout>
