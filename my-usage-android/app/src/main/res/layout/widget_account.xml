<?xml version="1.0" encoding="utf-8"?>
<!-- One account: its lowest window as a ring around its mark, its name and plan,
     then, in the 4x2, that window and when it resets with any other window worth a
     mention, and the figure; in the 4x4, a line of its own for every window shown.
     A flame marks a window that is ahead of pace, and only that window. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp">

        <ImageView
            android:id="@+id/row_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/row_level"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/row_logo"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/widget_ink" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/row_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink_quiet"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_window"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_ink_secondary"
                android:textSize="12sp" />

            <Chronometer
                android:id="@+id/row_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_ink_secondary"
                android:textSize="12sp" />

            <!-- The first mention, as a group, so a flame and its window come and go together. -->
            <LinearLayout
                android:id="@+id/row_m1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/row_m1_flame"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/widget_ahead"
                    android:src="@drawable/ic_flame"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/row_m1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/row_m1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/row_m2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/widget_ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row_m2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/widget_ink_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The 4x4: one widget_limit per window, filled in by the renderer. -->
        <LinearLayout
            android:id="@+id/row_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_flame"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="3dp"
        android:contentDescription="@string/widget_ahead"
        android:src="@drawable/ic_flame"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/row_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_left"
        android:textColor="@color/widget_ink_secondary"
        android:textSize="12sp" />
</LinearLayout>
