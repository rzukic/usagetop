<?xml version="1.0" encoding="utf-8"?>
<!-- Rings you choose: two to four windows, each a ring with its figure inside and
     its mark and window under it. -->
<!-- The rings for a small 2x2, as launchers with many columns give: the same
     cells, smaller, so all four rings and their names still fit at about 120 dp.
     The launcher may hand a 2x2 a cell that is not square; the panel inside is
     kept square and centred (see WidgetRenderer.squared). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/widget_panel"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cell1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageView
                        android:id="@+id/cell1_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/cell1_level"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cell1_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_ink"
                        android:textSize="11.5sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cell1_logo"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:contentDescription="@null"
                        android:tint="@color/widget_ink" />

                    <TextView
                        android:id="@+id/cell1_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageView
                        android:id="@+id/cell2_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/cell2_level"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cell2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_ink"
                        android:textSize="11.5sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cell2_logo"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:contentDescription="@null"
                        android:tint="@color/widget_ink" />

                    <TextView
                        android:id="@+id/cell2_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cell3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageView
                        android:id="@+id/cell3_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/cell3_level"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cell3_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_ink"
                        android:textSize="11.5sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cell3_logo"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:contentDescription="@null"
                        android:tint="@color/widget_ink" />

                    <TextView
                        android:id="@+id/cell3_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">

                    <ImageView
                        android:id="@+id/cell4_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/cell4_level"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/cell4_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/widget_ink"
                        android:textSize="11.5sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cell4_logo"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:contentDescription="@null"
                        android:tint="@color/widget_ink" />

                    <TextView
                        android:id="@+id/cell4_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_ink_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
