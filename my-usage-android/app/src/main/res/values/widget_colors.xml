<?xml version="1.0" encoding="utf-8"?>
<!-- The widget follows the system's light or dark setting; the app itself stays dark.
     Light is the default here, dark lives in values-night. A launcher cannot blur what
     is behind a widget, so the panel is nearly opaque: the text needs the floor.
     Rings and the line are shapes the ImageView colours from here, so they follow
     the setting too (see WidgetArt). -->
<resources>
    <color name="widget_panel">#E6FAFAFC</color>
    <color name="widget_hairline">#0F000000</color>
    <color name="widget_ink">#FF1C1C1E</color>
    <color name="widget_ink_secondary">#C73C3C43</color>
    <color name="widget_ink_quiet">#8C3C3C43</color>
    <color name="widget_divider">#14000000</color>
    <!-- Severity as text: darker than the ring colours, which only reach about
         2:1 on a light panel. -->
    <color name="widget_warning">#FF9A5F00</color>
    <color name="widget_critical">#FFB8322A</color>
    <color name="widget_action">#FF3F6CAD</color>
    <color name="widget_stale_fill">#2EE0A33C</color>
    <!-- Rings and the combined line are shapes coloured from here (see WidgetArt). -->
    <color name="widget_track">#21000000</color>
    <color name="widget_ring_normal">#FF5A86C2</color>
    <color name="widget_ring_warning">#FFC98A20</color>
    <color name="widget_ring_critical">#FFCC4B40</color>
    <color name="widget_line">#FF4F7DBE</color>
    <!-- An account's initials on a ring: the pill the other apps' rails show. -->
    <color name="widget_badge_fill">#FFE9E9EE</color>
    <color name="widget_badge_edge">#1F000000</color>
</resources>
