<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AiUsage" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#0A0A0A</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:windowBackground">@color/panel</item>
        <item name="android:statusBarColor">@color/panel</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- A full pill: 40dp tall, so the radius is half the height. Flat by design,
         no Material elevation or state animator. -->
    <style name="PillButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="PillButton.Tonal">
        <item name="backgroundTint">@color/control_fill</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CompactField">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CardCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Small tracked caps, the bucket labels in OpenUsage's Priority list. -->
    <style name="GroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
