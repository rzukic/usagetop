<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not a window: the providers, the sign-in flows, the
       arithmetic. Plain net9.0 so the Windows app and the Linux server share it. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiUsage.Core</AssemblyName>
    <RootNamespace>AiUsage</RootNamespace>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiUsage.Core.Tests" />
  </ItemGroup>

</Project>
