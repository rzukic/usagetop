<Window x:Class="AiUsage.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AiUsage.Views"
        Title="usagetop"
        Width="520"
        Height="760"
        MinWidth="420"
        MinHeight="420"
        Background="{StaticResource PanelBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="18,4,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="32">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="HeaderLogo"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Fill="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderTitle"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        ToolTip="Refresh"
                        Click="OnRefreshClick">
                    <Path x:Name="RefreshGlyph"
                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RefreshRotation" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>

            <views:DetailView x:Name="Detail"
                              Grid.Row="1"
                              Margin="0,14,0,0" />
        </Grid>
    </Grid>
</Window>
