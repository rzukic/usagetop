<Window x:Class="AiUsage.Views.DeviceCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in with Meta"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Border Background="{StaticResource PanelRaisedBrush}"
            BorderBrush="#1FFFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Approve this code in your browser"
                       Style="{StaticResource CardTitle}" />

            <TextBlock Text="The browser window that just opened is waiting for it."
                       Style="{StaticResource Hint}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <Border Background="{StaticResource ControlFillBrush}"
                    CornerRadius="10"
                    Margin="0,14,0,0"
                    Padding="16,12">
                <TextBlock x:Name="CodeText"
                           FontFamily="Consolas"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Copy code"
                        Style="{StaticResource QuietButton}"
                        Padding="10,5"
                        Click="OnCopyClick" />
                <Button Content="Open browser"
                        Style="{StaticResource PillButton}"
                        Padding="12,6"
                        Margin="6,0,0,0"
                        Click="OnOpenClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
