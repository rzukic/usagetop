<Project>
  <!-- Every .NET project in the repository: a built file names its sources and
       its symbol file by path, and without this that is the full path on the
       machine that built it, user folder and all. With it, the path starts at
       the repository's name instead. -->
  <PropertyGroup>
    <PathMap>$(MSBuildThisFileDirectory)=/rzukic/usagetop/</PathMap>
  </PropertyGroup>
</Project>
